# 실제 값은 포함하지 않습니다. docs/SETUP.md 참고
# Vercel 대시보드 > Settings > Environment Variables 에 같은 이름으로 등록합니다.

# ── Supabase (Vercel의 Supabase 연동을 쓰면 POSTGRES_URL·SUPABASE_URL·SUPABASE_SERVICE_ROLE_KEY가 자동 등록됩니다)
# Supabase > Connect > Transaction pooler (포트 6543) 연결 문자열
DATABASE_URL=
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 관리자
# 이 이메일로 가입하면 관리자 계정이 됩니다(/admin 사용, 서버 AI 키 사용). 여러 명은 쉼표로 구분
ADMIN_EMAILS=

# ── 암호화: AES-GCM 32바이트 키(base64). 생성: openssl rand -base64 32
# 바꾸면 이미 저장된 API 키를 복호화할 수 없으니 한 번 정한 뒤 유지하세요.
OFFICE_ENCRYPTION_KEY=

# ── 선택 사항: 관리자 계정만 쓰는 서버 AI 키. 다른 사용자는 화면에서 개인 키를 등록합니다
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
